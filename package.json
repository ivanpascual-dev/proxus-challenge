{
  "name": "proxus-challenge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @proxus/server --filter @proxus/web run dev",
    "prepare": "effect-language-service patch",
    "typecheck": "pnpm -r typecheck",
    "test": "node --import tsx --test \"packages/*/src/**/*.test.ts\"",
    "test:guardarrailes": "node --import tsx scripts/test-guardarrailes.mjs",
    "fixture:materials": "node packages/server/fixtures/make-fixture.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "index:materials": "pnpm --filter @proxus/server run index:materials"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@proxus/shared": "workspace:*",
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*"
  ]
}
